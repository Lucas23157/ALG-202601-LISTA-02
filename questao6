#include <stdio.h>

int main() {
    int n, i, soma = 0;
    
    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &n);
    
    if (n < 0) {
        printf("Por favor, digite um numero positivo!\n");
    } else {
        for (i = 1; i <= n; i++) {
            soma += i;
        }
        printf("A soma de todos os numeros de 1 a %d eh: %d\n", n, soma);
    }
    
    system("pause");
    return 0;
}
