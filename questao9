#include <stdio.h>

int main() {
    float tamanho_arquivo_mb, velocidade_mbps, tempo_segundos, tempo_minutos;
    
    printf("Calculo do tempo de download\n");
    printf("Digite o tamanho do arquivo (em MB): ");
    scanf("%f", &tamanho_arquivo_mb);
    printf("Digite a velocidade da internet (em Mbps): ");
    scanf("%f", &velocidade_mbps);
    
    
    tempo_segundos = (tamanho_arquivo_mb * 8) / velocidade_mbps;
    tempo_minutos = tempo_segundos / 60;
    
    printf("\nTempo aproximado de download: %.2f minutos (%.2f segundos)\n", 
           tempo_minutos, tempo_segundos);
    
    system("pause");
    return 0;
}
